<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.albertonavas.missionbriefing</groupId>
        <artifactId>mission-briefing-planner</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mission-client-fx</artifactId>
    <packaging>jar</packaging>
    <name>mission-client-fx</name>
    <description>
        Cliente de escritorio principal en JavaFX: lista de misiones, formulario de
        creacion y timeline, consumiendo la API REST de mission-server. Embebe el modulo
        Swing heredado (mapa) via SwingNode en vez de reescribirlo.
    </description>

    <properties>
        <jackson.version>2.17.2</jackson.version>
        <!-- por defecto Windows; los perfiles de abajo la pisan en mac/Linux -->
        <javafx.platform>win</javafx.platform>
    </properties>

    <profiles>
        <profile>
            <id>javafx-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-linux</id>
            <activation>
                <os><family>unix</family><name>linux</name></os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.awt.headless=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- permite "mvn javafx:run" en desarrollo sin tener que montar un jar modular -->
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.albertonavas.missionbriefing.clientfx.MissionPlannerApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.albertonavas.missionbriefing</groupId>
            <artifactId>mission-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.albertonavas.missionbriefing</groupId>
            <artifactId>mission-client-swing-legacy</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
