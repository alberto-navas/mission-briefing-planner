<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.albertonavas.missionbriefing</groupId>
    <artifactId>mission-briefing-planner</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mission Briefing Planner</name>
    <description>
        Planificador de misiones operativas propias (reconocimiento, logistica, escolta)
        con generacion de briefing y archivo historico buscable. Backend REST en Spring Boot,
        cliente de escritorio JavaFX que embebe un modulo Swing heredado para la vista de mapa.
    </description>

    <modules>
        <module>mission-model</module>
        <module>mission-server</module>
        <module>mission-client-swing-legacy</module>
        <module>mission-client-fx</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.4</spring-boot.version>
        <javafx.version>21.0.4</javafx.version>
        <jxmapviewer2.version>2.8</jxmapviewer2.version>
        <junit.version>5.10.3</junit.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>21</release>
                        <!-- Spring Boot 3 / Spring Framework 6 ya no recupera nombres de
                             parametro via ASM: sin -parameters, @PathVariable/@RequestParam
                             sin nombre explicito fallan en tiempo de ejecucion (no en
                             compilacion), con un IllegalArgumentException dificil de
                             asociar a esta causa la primera vez que se ve. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- en <plugins>, no <pluginManagement>: asi cada modulo hijo lo hereda y ejecuta
             sin tener que redeclararlo -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
